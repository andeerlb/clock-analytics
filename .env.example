# Frontend da versão web. Copie para .env.local (ignorado pelo git).
#
# Sem as variáveis VITE_FIREBASE_*, o `yarn dev` roda sem tela de login e o
# servidor local responde como TAPAGO_DEV_USER_EMAIL. Um build de produção
# sem elas mostra um erro em vez de pular o login.
#
# Onde achar: console do Firebase → Configurações do projeto → Seus apps → app Web.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# URL do servidor em produção, ex. https://tapago.duckdns.org (vazio em dev: o Vite repassa /api).
VITE_API_URL=
