{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PontoScan",
  "version": "0.1.38",
  "identifier": "com.andeerlb.pontoscan",
  "build": {
    "beforeDevCommand": "yarn dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "yarn build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "PontoScan",
        "width": 1280,
        "height": 800,
        "maximized": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDdFOEEzRTYyODU2RUY3MDYKUldRRzkyNkZZajZLZnZrdE9UZDk3T0gyajNuVnZEVFJvYnBtUnJpT2ZmeHkzemlIRldNK0RySUQK",
      "endpoints": [
        "https://github.com/andeerlb/clock-analytics/releases/latest/download/latest.json"
      ]
    }
  }
}
